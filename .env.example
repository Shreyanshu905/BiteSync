# ==========================================
# BiteSync - Root Environment Variables Guide
# ==========================================

# Backend Configuration (backend/.env)
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/bitesync
JWT_SECRET=bitesync-super-secret-jwt-key-2026-production
QR_SECRET=bitesync-qr-hmac-secret-signature-2026
NODE_ENV=development

# Frontend Configuration (frontend/.env)
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5001

